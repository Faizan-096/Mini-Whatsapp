<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
    <link rel="stylesheet" href="chatStyle.css"/>
</head>
<body>
    <div class="header">
    <h3>All chats !</h3>
    <form method="GET" action="/chats/new">
    <button>Creat a chat</button>
   </form> 
   </div>
   <% for(let chat of chats){ %>
        <div class="chat"> 
            <p >From :<i> <%= chat.from %> </i></p>
            <div class="msg">
                <p><%= chat.msg  %></p>
                <form method="GET" action="/chats/<%= chat._id %>/edit">
                    <button>Edit</button>
                </form>
                 <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE">
                    <button>Delete</button>
                </form>
            </div>
            <p>Received By: <i> <%= chat.to %> </i> </p>
            <br>
            <p><%= chat.created_at.toString().split(" ")[4]  %></p>
            <p><%= chat.created_at.toString().split(" ").slice(0,4).join("-")  %></p>
        </div>
  <%  } %>

  <div class="footer">
    <form action="/chats" method="POST" class="send-form">
    <input
        type="text"
        name="from"
        placeholder="Your name"
    >

    <input
        type="text"
        name="to"
        placeholder="Receiver"
    >

    <textarea
        name="msg"
        placeholder="Type a message..."
    ></textarea>

    <button>Send</button>
</form>
   
   </div>

   <script>
    window.onload = function () {
        window.scrollTo(0, document.body.scrollHeight);
    };
</script>

</body>

</html>