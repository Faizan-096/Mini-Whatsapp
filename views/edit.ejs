<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your message</title>
    <link rel="stylesheet" href="/editStyle.css">
</head>
<body>
    <div class="container">
        <h3>Edit your chat</h3>
         <h4>id: <%= chat._id  %></h4>

        <p>
            From <b><%= chat.from %></b> to
            <b><%= chat.to %></b>
        </p>

        <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
            <textarea name="msg"><%= chat.msg %></textarea>
            <button type="submit">Update Chat</button>
        </form>
    </div>
</body>
</html>
